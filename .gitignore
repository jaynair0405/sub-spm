# Logs
*.log

# Database
*.db
*.sqlite

# Excel data files (large, temporary)
*.xlsx
*.xls
*.csv

# ...except the three config CSVs the app loads at startup. These are
# hand-edited reference data (train numbers, codes, halt patterns, routes)
# and need version history — a silent corruption in one of them went
# unnoticed for exactly this reason. Everything else, including StaffData
# and the daily analysis exports, stays ignored.
!Fast Locals.csv
!train_corridor_map.csv
!Sub  SPM Data Analysis - All Locals.csv

# ...and the corridor files in data/, loaded at startup by
# load_default_corridors(). These hold the inter-station distances every
# position calculation depends on, and they are hand-curated the same way
# the three above are. 160K for all 16. Left untracked they had no history
# and no way back from git, and because the loader skips a missing or
# unparseable file without complaint, losing one degraded the app silently.
!data/*.csv

# The .docx/.xlsx/.pdf sitting in data/ are working notes, not app inputs.
data/*.docx

# Local pre-edit backups (e.g. "Fast Locals.csv.bak-2026-07-29").
# Note *.csv above does NOT catch these — the name does not end in .csv.
*.bak
*.bak-*
*.bak2-*

# PDF files
*.pdf

# Reference apps (separate projects)
rail-data-app/
rail-data-app-main/
rail-data-app-main.zip
bbtro-master/
bbtro-master.zip

# Screenshots and images
*.png
*.jpeg
*.jpg

# Test cache
.pytest_cache/

# Claude Code
.claude/

# Graphify tool output (large local cache)
graphify-out/
.graphifyignore

# Generated motorman PDF reports (runtime data)
reports/

# Reference JS/HTML files (downloaded)
general.js
overspeed.js
scriptjs.html
